.vscode/**
.vscode-test/**
.claude/**
src/**
out/test/**
.gitignore
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.test.js
# DO NOT exclude node_modules/** — vsce relies on this directory to
# ship the extension's runtime dependencies (vscode-languageclient and
# its transitive deps). Excluding it produced 0.1.14–0.1.17 .vsix
# bundles where `require('vscode-languageclient/node')` failed at
# load time, taking activate() down with it and producing the
# "command 'tf-analyze.showAttackGraph' not found" symptom because no
# command ever got registered.
*.vsix
# Round-4 audit cleanup — icon-mockups/ are visual-design assets
# kept in the repo for future icon refreshes; they should not ship
# in the published .vsix (33 PNG files, ~700 KB of bundle bloat).
icon-mockups/**
