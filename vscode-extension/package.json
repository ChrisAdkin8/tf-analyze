{
  "name": "tf-analyze",
  "displayName": "tf-analyze",
  "description": "Terraform security and stack analysis — inline findings, Quick Fix, and attack-graph view",
  "version": "0.1.56",
  "publisher": "tfanalyze",
  "license": "Apache-2.0",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ChrisAdkin8/tf-analyze.git",
    "directory": "vscode-extension"
  },
  "keywords": [
    "terraform",
    "security",
    "hcl",
    "iac",
    "tfsec",
    "static analysis"
  ],
  "activationEvents": [
    "onLanguage:terraform",
    "onView:tfAnalyzeFindings",
    "onView:tfAnalyzeBlastRadius",
    "workspaceContains:**/*.tf"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tf-analyze.runScan",
        "title": "tf-analyze: Run Scan",
        "icon": "$(shield)"
      },
      {
        "command": "tf-analyze.clearFindings",
        "title": "tf-analyze: Clear Findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "tf-analyze.showAttackGraph",
        "title": "tf-analyze: Show Attack Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "tf-analyze.showHtmlReport",
        "title": "tf-analyze: Show Report",
        "icon": "$(file-text)"
      },
      {
        "command": "tf-analyze.showDelta",
        "title": "tf-analyze: Since Last Scan (Delta)",
        "icon": "$(diff)"
      },
      {
        "command": "tf-analyze.showCompliance",
        "title": "tf-analyze: Show Compliance Report",
        "icon": "$(checklist)"
      },
      {
        "command": "tf-analyze.showMitre",
        "title": "tf-analyze: Show MITRE ATT&CK View"
      },
      {
        "command": "tf-analyze.remediate",
        "title": "tf-analyze: Remediate (preview & apply fixes)",
        "icon": "$(wand)"
      },
      {
        "command": "tf-analyze.showModuleReuse",
        "title": "tf-analyze: Show Module Reuse Advisor",
        "icon": "$(package)"
      },
      {
        "command": "tf-analyze.explainRule",
        "title": "tf-analyze: Explain Rule (by ID)",
        "icon": "$(book)"
      },
      {
        "command": "tf-analyze.suppressFinding",
        "title": "tf-analyze: Suppress Finding (add to baseline)"
      },
      {
        "command": "tf-analyze.unsuppressFinding",
        "title": "tf-analyze: Unsuppress Finding (remove from baseline)"
      },
      {
        "command": "tf-analyze.openBaseline",
        "title": "tf-analyze: Open Baseline File"
      },
      {
        "command": "tf-analyze.openFinding",
        "title": "tf-analyze: Open Finding"
      },
      {
        "command": "tf-analyze.showBlastRadius",
        "title": "tf-analyze: Show Blast Radius",
        "icon": "$(flame)"
      },
      {
        "command": "tf-analyze.toggleCritical",
        "title": "tf-analyze: Toggle Critical severity in Findings view",
        "icon": "$(error)"
      },
      {
        "command": "tf-analyze.toggleHigh",
        "title": "tf-analyze: Toggle High severity in Findings view",
        "icon": "$(warning)"
      },
      {
        "command": "tf-analyze.toggleMedium",
        "title": "tf-analyze: Toggle Medium severity in Findings view",
        "icon": "$(info)"
      },
      {
        "command": "tf-analyze.toggleLow",
        "title": "tf-analyze: Toggle Low severity in Findings view",
        "icon": "$(circle-large-outline)"
      }
    ],
    "configuration": {
      "title": "tf-analyze",
      "properties": {
        "tf-analyze.scriptPath": {
          "type": "string",
          "default": "",
          "description": "Path to detect.py. Leave empty to auto-detect from workspace or PATH."
        },
        "tf-analyze.failOn": {
          "type": "string",
          "default": "HIGH",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL"
          ],
          "description": "Minimum urgency level to mark as an error (vs. warning/info)."
        },
        "tf-analyze.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically re-run tf-analyze when a .tf file is saved."
        },
        "tf-analyze.section": {
          "type": "string",
          "default": "",
          "enum": [
            "",
            "security",
            "robustness",
            "ops",
            "module",
            "stack",
            "style"
          ],
          "description": "Restrict findings to a single catalogue section. Empty = all sections."
        },
        "tf-analyze.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional CLI flags passed to detect.py (e.g. ['--compliance', '--compliance-framework', 'pci_dss'])."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tfAnalyze",
          "title": "tf-analyze",
          "icon": "assets/icon-activitybar.svg"
        }
      ]
    },
    "views": {
      "tfAnalyze": [
        {
          "id": "tfAnalyzeFindings",
          "name": "Findings",
          "contextualTitle": "tf-analyze"
        },
        {
          "id": "tfAnalyzeBlastRadius",
          "name": "Blast Radius",
          "contextualTitle": "tf-analyze"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "tfAnalyzeBlastRadius",
        "contents": "Blast radius identifies resources whose destruction or recreation would cascade to the most downstream dependents — the resources to handle with care on apply.\n\n[Run Scan](command:tf-analyze.runScan)\n\nThe list populates after a scan. If you've already scanned and this view is empty, your workspace's dependency graph has no resource with a downstream count above zero — try `examples/attack-graph-demo/` from the tf-analyze repo for a worked example."
      },
      {
        "view": "tfAnalyzeFindings",
        "contents": "[Run Scan](command:tf-analyze.runScan)\n\nFindings populate after a scan. Save a `.tf` file to auto-scan (configurable via `tf-analyze.runOnSave`)."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tf-analyze.runScan",
          "when": "resourceExtname == .tf",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "tf-analyze.showAttackGraph",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.showHtmlReport",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.showDelta",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.showCompliance",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.remediate",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.showModuleReuse",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.runScan",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        },
        {
          "command": "tf-analyze.clearFindings",
          "when": "view == tfAnalyzeFindings",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "tf-analyze.suppressFinding",
          "when": "view == tfAnalyzeFindings && viewItem == finding",
          "group": "1_baseline"
        },
        {
          "command": "tf-analyze.unsuppressFinding",
          "when": "view == tfAnalyzeFindings && viewItem == finding",
          "group": "1_baseline"
        }
      ]
    },
    "statusBar": [],
    "walkthroughs": [
      {
        "id": "tfAnalyze.gettingStarted",
        "title": "Get started with tf-analyze",
        "description": "Run your first Terraform security scan in under a minute.",
        "steps": [
          {
            "id": "tfAnalyze.connectEngine",
            "title": "Connect the detection engine",
            "description": "Set `tf-analyze.scriptPath` or open the [tf-analyze project](https://github.com/ChrisAdkin8/tf-analyze) as part of your workspace.\n[Open Settings](command:workbench.action.openSettings?%22tf-analyze%22)",
            "media": {
              "markdown": "media/walkthrough/01-engine.md"
            },
            "completionEvents": [
              "onSettingChanged:tf-analyze.scriptPath"
            ]
          },
          {
            "id": "tfAnalyze.firstScan",
            "title": "Run your first scan",
            "description": "Open any `.tf` file and save it — or run **tf-analyze: Run Scan** from the Command Palette.\n[Run Scan](command:tf-analyze.runScan)",
            "media": {
              "markdown": "media/walkthrough/02-scan.md"
            },
            "completionEvents": [
              "onCommand:tf-analyze.runScan"
            ]
          },
          {
            "id": "tfAnalyze.exploreFindings",
            "title": "Explore findings & fix issues",
            "description": "Click the 🛡 shield on the Activity Bar to open the Findings tree, hover squiggles for details, and use Quick Fix (`⌘.` / `Ctrl+.`) for auto-remediation.\n[Show Attack Graph](command:tf-analyze.showAttackGraph)",
            "media": {
              "markdown": "media/walkthrough/03-explore.md"
            },
            "completionEvents": [
              "onView:tfAnalyzeFindings"
            ]
          },
          {
            "id": "tfAnalyze.tryDemoWorkspaces",
            "title": "Try the showcase demos",
            "description": "Two example corpora exercise the deeper panels end-to-end. Clone the [tf-analyze repo](https://github.com/ChrisAdkin8/tf-analyze) and open one of:\n- `examples/module-reuse-demo/` — five hand-rolled VPC/network/AKS clusters that match community modules. Click 📦 Module Reuse.\n- `examples/attack-graph-demo/` — multi-tier AWS app with internet → IAM → crown-jewels reachability. Click 🛤 Attack Graph.\n[Show Module Reuse](command:tf-analyze.showModuleReuse)",
            "media": {
              "markdown": "media/walkthrough/04-demos.md"
            },
            "completionEvents": [
              "onCommand:tf-analyze.showModuleReuse",
              "onCommand:tf-analyze.showAttackGraph"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle-engine && npm run compile",
    "bundle-engine": "node ./scripts/bundle-engine.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run bundle-engine && npm run compile",
    "test": "node --test out/test/*.test.js",
    "prepackage": "npm run bundle-engine && npm run compile",
    "package": "vsce package --baseImagesUrl https://github.com/ChrisAdkin8/tf-analyze/raw/HEAD/vscode-extension",
    "publish": "vsce publish --baseImagesUrl https://github.com/ChrisAdkin8/tf-analyze/raw/HEAD/vscode-extension"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.3.0",
    "@vscode/vsce": "^2.22.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
